# Backend settings (read from this file when running from the project root).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
OCR_ENGINE=auto
OCR_LANGUAGES=eng+urd
OCR_MIN_CONFIDENCE=0.35
REGISTRY_PROVIDER=local_demo
SEED_DEMO_ON_STARTUP=true
MAX_UPLOAD_MB=15

# Optional vision fallback. Leave disabled for the offline demo.
VISION_LLM_ENABLED=false
VISION_LLM_API_KEY=
VISION_LLM_BASE_URL=https://api.openai.com/v1
VISION_LLM_MODEL=gpt-4o-mini

# Frontend: leave empty to use the same-origin /api proxy.
# VITE_API_BASE_URL=/api
